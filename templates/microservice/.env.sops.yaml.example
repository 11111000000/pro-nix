# Зашифрованный шаблон секретов для compose-стека.
#
# Использование:
#   1. Скопировать в свой проект: `cp .env.sops.yaml.example .env.sops.yaml`
#   2. Заполнить значения (плейсхолдеры CHANGE_ME)
#   3. Зашифровать: `sops --encrypt --in-place .env.sops.yaml`
#   4. Расшифровка автоматическая: docker compose подхватит .env.sops.yaml
#      (если установлен sops plugin) или через `sops --decrypt` вручную.
#
# Расшифровка работает для членов age-группы, чей pubkey добавлен
# в .sops.yaml. Один файл может расшифровать несколько человек и
# несколько хостов — добавьте pubkey каждого в .sops.yaml.

# HTTP-порт, на котором сервис слушает ВНУТРИ контейнера.
# В compose.yaml он маппится на ${SERVICE_PORT:-8000} на хосте.
SERVICE_PORT: 8000

# Логирование
LOG_LEVEL: info

# Секреты: замените CHANGE_ME на реальные значения перед шифрованием
DATABASE_URL: postgresql://app:CHANGE_ME@postgres:5432/myapp
API_KEY: CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32
JWT_SECRET: CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_64
