set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Justfile для локальной разработки одного микросервиса.
# Копия рецептов из корневого justfile (pro-nix), адаптированная
# под отдельный compose-проект.

default:
	@just --list

# Собрать образ (использует Dockerfile в текущей директории)
build:
	docker compose build

# Поднять стек в фоне
up:
	docker compose up -d

# Остановить стек (контейнеры остаются, можно start)
down:
	docker compose down

# Перезапустить сервис `app` (или укажите свой)
restart SERVICE="app":
	docker compose restart {{SERVICE}}

# Хвост логов всех сервисов
logs:
	docker compose logs -f --tail 50

# Хвост логов конкретного сервиса
logs-svc SERVICE:
	docker compose logs -f --tail 50 {{SERVICE}}

# Shell в сервисе `app`
sh SERVICE="app":
	docker compose exec {{SERVICE}} sh

# Состояние стека
ps:
	docker compose ps

# Сканировать локальный образ на CVE
scan:
	trivy image --severity HIGH,CRITICAL --no-progress my-svc:dev

# Линт Dockerfile (hadolint)
lint:
	hadolint Dockerfile

# Зашифровать секреты (после правки .env.sops.yaml.example → .env.sops.yaml)
encrypt-secrets:
	sops --encrypt --in-place .env.sops.yaml

# Расшифровать секреты (нужно для запуска вне docker compose sops-плагина)
decrypt-secrets:
	sops --decrypt .env.sops.yaml > .env
	@echo ".env создан (НЕ коммитьте — добавьте в .gitignore)"

# Полная очистка: контейнеры, тома, локальный .env
clean:
	docker compose down -v
	rm -f .env
