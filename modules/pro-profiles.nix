# Название: modules/pro-profiles.nix — Реестр профилей окружения
# Цель:
#   Ввести единое пространство опций `pro.profiles.*` для декларативных
#   профилей окружения (tui, exwm-minimal, desktop-cinnamon, exwm+tor+ygg и т.п.).
#   Конкретные профильные модули объявляют свои подопции внутри этого
#   пространства и вносят вклад в конфигурацию системы, не финализируя мир.
#
# Контракт:
#   - Опция `pro.profiles` — это словарь профилей, каждый профиль описывается
#     как подмодуль со своими опциями (например, `enable`).
#   - Сам этот модуль НЕ задаёт никакой конфигурации (config = {}), он только
#     объявляет опции. Поведение реализуют отдельные профильные модули.
#
# Предпосылки:
#   - Импортируется из корневой configuration.nix до модулей, которые
#     используют опции `pro.profiles.*`.
#
# Проверка (Proof):
#   - `nix eval .#nixosConfigurations.<host>.options.pro.profiles` возвращает
#     описание типа и подопций.
#   - Профильные модули (например, profile-exwm-minimal.nix) успешно
#     добавляют свои подопции и конфигурацию через `config.pro.profiles.*`.

{ lib, ... }:

{
  options.pro.profiles = lib.mkOption {
    # Тип submodule с пустыми options позволяет другим модулям
    # добавлять вложенные опции (pro.profiles.*.enable и т.п.).
    # Предыдущий тип attrsOf (submodule {}) не поддерживал вложенные опции,
    # что ломало profile-exwm-minimal.nix и другие профильные модули.
    type = lib.types.submodule { options = {}; };
    default = {};
    description = ''
      Пространство для декларативных профилей окружения (tui, exwm-minimal,
      desktop-cinnamon, exwm+tor+ygg и т.п.). Каждый профиль вносит вклад
      через собственные опции и конфигурацию, не финализируя мир.
    '';
  };
}
